{
  "name": "deepwiki-scraper",
  "version": "1.0.0",
  "description": "A command-line utility to extract content from DeepWiki projects and export them as JSON and Markdown files",
  "main": "dist/index.js",
  "scripts": {
    "start": "ts-node src/index.ts",
    "build": "tsc",
    "dev": "ts-node-dev --respawn src/index.ts",
