    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": ["scraper", "deepwiki", "markdown", "json", "extraction"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "playwright": "^1.52.0"
  }
}
